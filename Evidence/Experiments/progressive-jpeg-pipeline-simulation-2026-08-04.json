  "decision": {
    "addPresentationPolicyToCodec": false,
    "changeCodecThresholds": false,
    "hostIntegrationGuidance": [
      "Fence preview publication immediately when cancellation is requested; do not wait for session.cancel() to acquire the decoder lock.",
      "Keep presentation coalescing in the host/UI integration layer because it depends on frame cadence and network/decode backlog, not codec correctness.",
      "Use latest-candidate coalescing only as an overload control; the network-dominant scenario showed no preview-count reduction and only frame-alignment delay."
    ],
    "passed": true,
    "qualification": "pipeline profile and discrete-event model are reproducible; policy effects depend on whether decode or network is the bottleneck",
    "supportedClaims": [
      "On the bound Mac/ImageIO environment, detached-task to MainActor.run handoff is small relative to final complete-body decode for both retained chunk profiles.",
      "In the deterministic 80 Mbps/32 KiB decode-pressure model, measured append costs create queueing and multi-chunk buffering; 60 Hz coalescing reduces the median number of committed previews.",
      "In the deterministic 4 Mbps/16 KiB network-dominant model, measured append costs create no decode queue and 60 Hz coalescing does not reduce the median preview count.",
      "When cancellation intersects an in-flight append in the decode-pressure model, the cancellation call completes only after that append finishes, so a separate publication fence is required to suppress late pixels."
    ],
    "unsupportedClaims": [
      "The virtual network profiles reproduce URLSession, kernel socket buffering, radio behavior, or a named access network.",
      "MainActor.run completion means Core Animation committed or a GPU/display presented the image.",
      "The results establish energy, frame pacing, or user-perceived quality on iOS devices.",
      "A fixed 60 Hz coalescing policy is optimal for all hosts, refresh rates, images, or network conditions."
    ]
  },
