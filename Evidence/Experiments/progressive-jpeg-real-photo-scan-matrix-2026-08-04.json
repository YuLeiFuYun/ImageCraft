  "decision": {
    "passed": true,
    "qualification": "evidence matrix is reproducible; no scan policy is universally qualified",
    "supportedClaims": [
      "For each fixed source and encoder settings, all three scan scripts decode to identical final pixels in the retained matrix.",
      "Observed generation count and per-generation quality depend on transport chunk boundaries as well as JPEG scan ordering.",
      "Generation ordinal is only an in-session ordering token and cannot be compared as a quality level across sessions.",
      "The luma-frontloaded scan script is not uniformly superior and can leave a late preview materially different from the final decode."
    ],
    "unsupportedClaims": [
      "Any scan script is optimal for arbitrary photographs, devices, networks, or user tasks.",
      "PSNR, MAE, or channel-error coverage proves subjective usefulness or recognizability.",
      "The four-source corpus represents production image distributions.",
      "The matrix establishes network-to-screen latency, energy use, or iOS-device performance."
    ]
  },
